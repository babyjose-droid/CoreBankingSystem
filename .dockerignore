# Keep the build context small and free of secrets/local state.
.git
.github
.idea
*.iml
.env
.env.*
*.log
**/node_modules
frontend/**/node_modules
build
**/build
.gradle
**/.gradle
out
**/out
infra
deploy
# docs/api is packaged into the backend jar (developer portal); the rest of docs is not needed in the image build
docs/*
!docs/api
tools
*.tfstate
*.tfstate.*
**/.terraform
