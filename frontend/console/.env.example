# Copy to .env.local and adjust. Never commit real secrets; these are public client settings only.

# 1 = in-memory mock API + demo-user login (no backend or Keycloak needed)
VITE_MOCK=1

# Base URL of the CoreBanking API. Leave empty to use same-origin /api (proxied by `npm run dev` to http://localhost:8080).
VITE_API_BASE_URL=

# Keycloak realm (OIDC issuer) and public client id used for Authorization Code + PKCE.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/demo-nbfc
VITE_OIDC_CLIENT_ID=console
